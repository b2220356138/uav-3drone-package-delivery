function paths = run_greedy_coverage_3uav(startPositions, coveragePoints)
% run_greedy_coverage_3uav
% Balanced multi-UAV greedy coverage planner.
%
% Purpose:
% - All UAVs must receive coverage points.
% - Assignment is still greedy, but balanced by route length.
%
% Method:
% 1) Initialize each UAV with its own start position.
% 2) Give each UAV at least one nearest coverage point.
% 3) Repeatedly select the UAV with the currently shortest route.
% 4) Assign the nearest remaining coverage point to that UAV.

numUAV = size(startPositions,1);

paths = cell(1,numUAV);
currentPos = startPositions;
routeLengths = zeros(numUAV,1);

for u = 1:numUAV
    paths{u} = startPositions(u,:);
end

remaining = coveragePoints;

%% Step 1: Ensure every UAV gets at least one point

for u = 1:numUAV
    if isempty(remaining)
        break;
    end

    distances = vecnorm(remaining(:,1:3) - currentPos(u,:), 2, 2);
    [d, idx] = min(distances);

    nextPoint = remaining(idx,:);

    paths{u} = [paths{u}; nextPoint];
    currentPos(u,:) = nextPoint;
    routeLengths(u) = routeLengths(u) + d;

    remaining(idx,:) = [];
end

%% Step 2: Balanced greedy assignment

while ~isempty(remaining)

    % Choose UAV with shortest current route
    [~, selectedUAV] = min(routeLengths);

    distances = vecnorm(remaining(:,1:3) - currentPos(selectedUAV,:), 2, 2);
    [d, idx] = min(distances);

    nextPoint = remaining(idx,:);

    paths{selectedUAV} = [paths{selectedUAV}; nextPoint];
    currentPos(selectedUAV,:) = nextPoint;
    routeLengths(selectedUAV) = routeLengths(selectedUAV) + d;

    remaining(idx,:) = [];
end
end